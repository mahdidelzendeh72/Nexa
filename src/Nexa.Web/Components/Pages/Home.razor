@page "/"
@attribute [AllowAnonymous]

<PageTitle>Nexa</PageTitle>

<section class="hero">
    <h1>Nexa</h1>
    <p>Production agent platform — Phase 1 foundation. Create agents, configure models, and run persisted conversations.</p>
    <AuthorizeView>
        <Authorized>
            <a class="button" href="/chat">Open chat</a>
        </Authorized>
        <NotAuthorized>
            <a class="button" href="/Identity/Account/Login">Sign in</a>
        </NotAuthorized>
    </AuthorizeView>
</section>
