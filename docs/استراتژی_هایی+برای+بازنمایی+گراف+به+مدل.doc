<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: py; gutter: false; theme: Midnight" data-theme=3D"Midnight">def graph_to_=
text(graph):
    sentences =3D []
    for edge in graph["edges"]:
        sentence =3D f"{edge['source']} {edge['relation']} {edge['target']}=
."
        sentences.append(sentence)
    return " ".join(sentences)

# =D9=86=D9=85=D9=88=D9=86=D9=87 =DA=AF=D8=B1=D8=A7=D9=81
graph_data =3D {
    "nodes": ["Einstein", "Theory of Relativity"],
    "edges": [{"source": "Einstein", "relation": "developed", "target": "Th=
eory of Relativity"}]
}

# =D8=AA=D8=A8=D8=AF=DB=8C=D9=84 =DA=AF=D8=B1=D8=A7=D9=81 =D8=A8=D9=87 =D9=
=85=D8=AA=D9=86
text_representation =3D graph_to_text(graph_data)
print(text_representation) =20
# =D8=AE=D8=B1=D9=88=D8=AC=DB=8C: "Einstein developed Theory of Relativity.=
"

