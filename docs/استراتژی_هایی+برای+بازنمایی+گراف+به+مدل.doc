ollama_url =3D "http://localhost:11434"
embedding_model =3D "mistral"

embedder =3D OllamaEmbedding(base_url=3Dollama_url, model_name=3Dembedding_=
model)

def graph_to_embedding(graph):
    node_embeddings =3D {node: embedder.get_text_embedding(node) for node i=
n graph["nodes"]}
    mean_vector =3D np.mean(list(node_embeddings.values()), axis=3D0)
    return mean_vector

