: py; gutter: false; theme: Midnight" data-theme=3D"Midnight">def graph_to_=
paths(graph):
    paths =3D []
    for edge in graph["edges"]:
        paths.append(f"{edge['source']} =E2=86=92 {edge['relation']} =E2=86=
=92 {edge['target']}")
    return "\n".join(paths)

