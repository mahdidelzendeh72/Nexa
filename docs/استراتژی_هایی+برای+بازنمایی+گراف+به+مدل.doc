<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: py; gutter: false; theme: Midnight" data-theme=3D"Midnight">def graph_to_=
tree(graph):
    tree_structure =3D {}
    for edge in graph["edges"]:
        if edge["source"] not in tree_structure:
            tree_structure[edge["source"]] =3D []
        tree_structure[edge["source"]].append(f"{edge['relation']} =E2=86=
=92 {edge['target']}")
   =20
    text_output =3D ""
    for node, relations in tree_structure.items():
        text_output +=3D f"{node}\n"
        for rel in relations:
            text_output +=3D f" =E2=94=9C=E2=94=80=E2=94=80 {rel}\n"
    return text_output.strip()

print(graph_to_tree(graph_data)) &nbsp;</pre>=20
